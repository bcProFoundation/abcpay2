{
  "name": "@bcpros/abcpay-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:bun": "bun run --watch src/index.ts",
    "start:bun": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "import:legacy": "tsx src/migration/import-legacy.ts",
    "seed:staging": "node src/scripts/seed-staging-fixtures.cjs",
    "e2e:staging": "tsx src/scripts/staging-e2e.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bcpros/abcpay-models": "workspace:*",
    "@bcpros/abcpay-wallet-core": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.4",
    "mongodb": "^6.12.0",
    "postgres": "^3.4.5",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
