{
  "name": "@bcpros/abcpay-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:bun": "bun run --watch src/index.ts",
    "start:bun": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@bcpros/abcpay-models": "workspace:*",
    "@bcpros/abcpay-wallet-core": "workspace:*",
    "@bcpros/crypto-wallet-core": "9.0.9",
    "@hono/node-server": "^1.14.1",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.4",
    "postgres": "^3.4.5",
    "sjcl": "1.0.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
